#!/bin/sh
# Launcher: runs shellcopy.py with python3 (its dependencies are in vendor/ next to it, or installed system-wide).
# Works from any shell, and through symlinks (install.sh links it into ~/.local/bin as `shellcopy` and `cy`).
# Resolve symlinks by hand: `readlink -f` is missing on older macOS.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
		/*) self=$link ;;
		*) self=$(dirname "$self")/$link ;;
	esac
done
home=$(cd "$(dirname "$self")/.." && pwd)
SHELLCOPY_EXE="$home/bin/shellcopy" exec python3 "$home/shellcopy.py" "$@"
